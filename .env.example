TYPESENSE_HOST=typesense.example.com
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=products

INDEX_PATH=data/embeddings.index
METADATA_PATH=data/metadata.pkl

CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=cpu

SEARCH_TOP_K=20
MAX_UPLOAD_BYTES=10485760

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vs:

# copy sources.example.json to sources.json to search more than one shop
SOURCES_FILE=sources.json

# live web search (google shopping), get a free key at serpapi.com
SERPAPI_KEY=
WEB_COUNTRY=us
